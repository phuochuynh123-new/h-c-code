{
  // Tắt gợi ý code tự động của AI (ghost text / inline suggestions)
  "editor.inlineSuggest.enabled": false,

  // GitHub Copilot: tắt gợi ý cho mọi ngôn ngữ
  "github.copilot.enable": {
    "*": false
  },
  "github.copilot.editor.enableAutoCompletions": false,
  "github.copilot.nextEditSuggestions.enabled": false,
  "chat.commandCenter.enabled": false,

  // IntelliCode (gợi ý AI của Microsoft)
  "vsintellicode.features.python.deepLearning": "disabled",
  "vsintellicode.typescript.completionsEnabled": false,
  "vsintellicode.java.completionsEnabled": false,
  "vsintellicode.python.completionsEnabled": false,
  "vsintellicode.sql.completionsEnabled": false,

  // Tabnine / Codeium nếu có cài
  "tabnine.experimentalAutoImports": false,
  "codeium.enableCodeLens": false,
  "codeium.enableConfig": {
    "*": false
  }
}
